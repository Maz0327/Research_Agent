# =============================================================================
# Research Agent Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Core Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Required - Database & Auth)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-must-be-at-least-64-characters-long-for-hs256-algorithm

# Frontend Supabase (NEXT_PUBLIC_ prefix exposes to browser - safe for anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# LLM APIs (Required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------------------------------------------
# Search APIs
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-api-key
EXA_API_KEY=your-exa-api-key
SERPER_API_KEY=your-serper-api-key

# -----------------------------------------------------------------------------
# Google Services
# -----------------------------------------------------------------------------
# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Google OAuth (for Drive and Docs)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# Gemini API (for planning/vision)
GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# Transcription
# -----------------------------------------------------------------------------
SUPADATA_API_KEY=sd_your-supadata-api-key

# -----------------------------------------------------------------------------
# Reddit API (PRAW)
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=ResearchAgent/1.0 by YourUsername

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_DB=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
RAILWAY_TOKEN=your-railway-token

# -----------------------------------------------------------------------------
# Optional: Login Credentials (Future Phases)
# -----------------------------------------------------------------------------
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password
TWITTER_USERNAME=your-twitter-username
TWITTER_PASSWORD=your-twitter-password

# -----------------------------------------------------------------------------
# Optional: Additional APIs (Not Currently Used)
# -----------------------------------------------------------------------------
EXA_TEAM_ID=your-exa-team-id
BRAVE_SEARCH_API_KEY=your-brave-api-key
JINA_AI_READER_API_KEY=jina_your-jina-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
CLAIMBUSTER_API_KEY=your-claimbuster-api-key
SERPAPI_KEY=your-serpapi-key

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
PERPLEXITY_DEFAULT_MODEL=sonar
PERPLEXITY_PRO_MODEL=sonar-pro

# -----------------------------------------------------------------------------
# Cost Tracking Reference (January 2025)
# -----------------------------------------------------------------------------
# GPT-4o: $5.00/$15.00 per 1M tokens (input/output)
OPENAI_GPT4O_INPUT_COST_PER_1M=5.00
OPENAI_GPT4O_OUTPUT_COST_PER_1M=15.00
# GPT-4o-mini: $0.15/$0.60 per 1M tokens (input/output)
OPENAI_GPT4O_MINI_INPUT_COST_PER_1M=0.15
OPENAI_GPT4O_MINI_OUTPUT_COST_PER_1M=0.60
# Perplexity pricing
PERPLEXITY_SONAR_COST_PER_1M=0.20
PERPLEXITY_SONAR_PRO_COST_PER_1M=3.00
# YouTube: FREE (10,000 units/day quota)
YOUTUBE_QUOTA_LIMIT=10000
# Reddit: FREE for non-commercial use
REDDIT_FREE_TIER_QPM=100
