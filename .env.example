# Environment
ENVIRONMENT=dev  # Use 'production' for Railway
API_HOST=0.0.0.0
API_PORT=8000

# Service Type (for Railway unified Dockerfile)
# api = Run Uvicorn API server (default)
# worker = Run Celery worker
SERVICE_TYPE=api

# Redis (for Celery broker/backend)
# Local: redis://localhost:6379/0
# Railway: Use ${{Redis.REDIS_URL}} reference
REDIS_URL=redis://localhost:6379/0

# Supabase (required for job persistence and auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS Origins (comma-separated list of allowed frontend URLs)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# Slack integration
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# OpenAI API (for LLM operations)
OPENAI_API_KEY=sk-your-openai-api-key

# Perplexity AI API
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Google OAuth (for Drive and Docs access)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# Google Drive (optional)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# V2 API Integrations (optional - enhances research quality)
EXA_API_KEY=your-exa-api-key
BRAVE_API_KEY=your-brave-search-api-key
JINA_API_KEY=your-jina-reader-api-key
CLAIMBUSTER_API_KEY=your-claimbuster-api-key

# Reddit API (optional - for Reddit content)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password

# Note: Railway environment variables cannot contain dots in names
# Use EXAAI_SECRET_KEY instead of EXA.AI_SECRET_KEY for Railway
