# Research Agent Environment Variables
# Copy this to .env and fill in your actual values

# ==========================================
# General Application Configuration
# ==========================================
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Database - Supabase
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# AI APIs
# ==========================================

# OpenAI (for LLM operations - planning, extraction, analysis)
OPENAI_API_KEY=sk-your-openai-key-here

# Perplexity (for web search and validation)
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# ==========================================
# Source APIs
# ==========================================

# YouTube Data API v3
YOUTUBE_API_KEY=AIza-your-youtube-api-key-here

# Reddit API (NEW - REQUIRED for Phase 2.3)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=ResearchAgent/1.0 by YourRedditUsername

# ==========================================
# Google OAuth (for Drive and Docs)
# ==========================================
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# ==========================================
# Slack Integration (Optional)
# ==========================================
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ==========================================
# Cost Tracking (NEW - for budget controls)
# API pricing as of January 2025
# ==========================================

# OpenAI GPT-4o Pricing (per 1M tokens)
OPENAI_GPT4O_INPUT_COST_PER_1M=5.00
OPENAI_GPT4O_OUTPUT_COST_PER_1M=15.00

# OpenAI GPT-4o-mini Pricing (90% cheaper - use for simple tasks)
OPENAI_GPT4O_MINI_INPUT_COST_PER_1M=0.15
OPENAI_GPT4O_MINI_OUTPUT_COST_PER_1M=0.60

# Perplexity Pricing (per 1M tokens)
PERPLEXITY_SONAR_COST_PER_1M=0.20
PERPLEXITY_SONAR_PRO_COST_PER_1M=3.00

# YouTube API (FREE - 10,000 units/day quota)
YOUTUBE_QUOTA_LIMIT=10000

# Reddit API (FREE for non-commercial use)
REDDIT_FREE_TIER_QPM=100

# ==========================================
# Model Selection (NEW - for cost optimization)
# ==========================================
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
PERPLEXITY_DEFAULT_MODEL=sonar
PERPLEXITY_PRO_MODEL=sonar-pro

# ==========================================
# Legacy/Future (Optional - not currently used)
# ==========================================
REDDIT_USERNAME=
REDDIT_PASSWORD=
TWITTER_USERNAME=
TWITTER_PASSWORD=
