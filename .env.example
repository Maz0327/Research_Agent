# =============================================================================
# Research Agent Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Core Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002

# -----------------------------------------------------------------------------
# Supabase (Required - Database & Auth)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-must-be-at-least-64-characters-long-for-hs256-algorithm

# Frontend Supabase (NEXT_PUBLIC_ prefix exposes to browser - safe for anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# LLM APIs (Required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key
PERPLEXITY_API_KEY=pplx-your-perplexity-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------------------------------------------
# Search APIs
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-api-key
EXA_API_KEY=your-exa-api-key
SERPER_API_KEY=your-serper-api-key

# -----------------------------------------------------------------------------
# Google Services
# -----------------------------------------------------------------------------
# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Google OAuth (for Drive and Docs)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# Gemini API (for planning/vision)
GOOGLE_API_KEY=your-google-api-key

# -----------------------------------------------------------------------------
# Transcription
# -----------------------------------------------------------------------------
SUPADATA_API_KEY=sd_your-supadata-api-key

# -----------------------------------------------------------------------------
# Visual Analysis (Optional — Kimi K2.5 for frame-level video analysis)
# Falls back to Gemini Flash vision if not configured
# -----------------------------------------------------------------------------
KIMI_API_KEY=your-moonshot-api-key

# -----------------------------------------------------------------------------
# Reddit API (PRAW)
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=ResearchAgent/1.0 by YourUsername

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_DB=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
RAILWAY_TOKEN=your-railway-token

# -----------------------------------------------------------------------------
# Optional: Login Credentials (Future Phases)
# -----------------------------------------------------------------------------
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password
TWITTER_USERNAME=your-twitter-username
TWITTER_PASSWORD=your-twitter-password

# -----------------------------------------------------------------------------
# Optional: Additional APIs (Not Currently Used)
# -----------------------------------------------------------------------------
EXA_TEAM_ID=your-exa-team-id
BRAVE_SEARCH_API_KEY=your-brave-api-key
JINA_AI_READER_API_KEY=jina_your-jina-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
CLAIMBUSTER_API_KEY=your-claimbuster-api-key
SERPAPI_KEY=your-serpapi-key

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
PERPLEXITY_DEFAULT_MODEL=sonar
PERPLEXITY_PRO_MODEL=sonar-pro

# -----------------------------------------------------------------------------
# Cost Tracking Reference (January 2025)
# -----------------------------------------------------------------------------
# GPT-4o: $5.00/$15.00 per 1M tokens (input/output)
OPENAI_GPT4O_INPUT_COST_PER_1M=5.00
OPENAI_GPT4O_OUTPUT_COST_PER_1M=15.00
# GPT-4o-mini: $0.15/$0.60 per 1M tokens (input/output)
OPENAI_GPT4O_MINI_INPUT_COST_PER_1M=0.15
OPENAI_GPT4O_MINI_OUTPUT_COST_PER_1M=0.60
# Perplexity pricing
PERPLEXITY_SONAR_COST_PER_1M=0.20
PERPLEXITY_SONAR_PRO_COST_PER_1M=3.00
# YouTube: FREE (10,000 units/day quota)
YOUTUBE_QUOTA_LIMIT=10000
# Reddit: FREE for non-commercial use
REDDIT_FREE_TIER_QPM=100

# =============================================================================
# MODEL LINEUP (EXECUTION-PLAN section 1; no model string is hardcoded)
# =============================================================================
# Per-source semantic extraction. 3.6 over 3.7: 3.7 removed thinking_level
# "minimal" (confirmed live: HTTP 400) and regressed on hallucination.
# NOTE (D-027): gemini-2.5-flash still extracts 7.5x more material on the same
# sources, and the 2.5 line retires 2026-10-16. Read D-027 before changing.
MODEL_EXTRACTION=gemini-3.6-flash
EXTRACTION_THINKING_LEVEL=minimal

# Extraction quota, per 1,000 words of source, as "low-high" (D-030). Every
# Gemini 3.x model returns a roughly fixed NUMBER of items whatever it is
# handed, so the quota is what keeps a long source from being summarized: with
# it, 3.6-flash went from 39 quotes to 182 over the same six sources.
EXTRACTION_QUOTES_PER_1000=8-12
EXTRACTION_CLAIMS_PER_1000=6-10
EXTRACTION_KEY_POINTS_PER_1000=2-4

# Gap analysis and cross-source reasoning. Won the D-031 A/B outright: three
# runs of the Hawara gap analysis each returned 7 gaps with every hard atom
# (number, name, quoted span) traceable to the corpus. gemini-3.1-pro returned
# 3-4 gaps and put an ungrounded atom in all three runs; 3.6-flash was worse
# still at 11-14%. NOTE: this shares a vendor with MODEL_JUDGE - see D-031.
MODEL_REASONING=gpt-5.4-mini

# Claim-graph distillation, the Briefing prose, and the Section-1 Read.
MODEL_DISTILL=claude-sonnet-5
MODEL_ESCALATION=claude-opus-5
MODEL_HARVEST=claude-sonnet-5

# Independent audit. LAW: never a Claude model while Claude does synthesis,
# and never the same vendor as extraction. Won the contest on 2026-08-20
# (D-028): kappa 0.900 vs 0.550, zero call failures vs 46.
MODEL_JUDGE=gpt-5.6-terra

# Frame and image analysis. WARNING: the 2.5 line retires 2026-10-16.
MODEL_VISION=gemini-2.5-pro

# Per-source fact harvest (work order B10)
HARVEST_ENABLED=true
HARVEST_MAX_CHARS=24000

# Doc 3, the Creator Brief, is retired from the default run (work order 16)
CREATOR_BRIEF_ENABLED=false
